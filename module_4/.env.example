# Copy to module_4/.env (git-ignored) or export these in your shell / CI.
# Real environment variables always win over values in .env.
# Real values are NEVER committed.

# The one setting the app, the loader, the query scripts and the tests need.
DATABASE_URL=postgresql://gradcafe_app:change-me@localhost:5432/gradcafe

# Optional: the tests use a scratch database. Default = DATABASE_URL with the database
# name replaced by gradcafe_test.
# TEST_DATABASE_URL=postgresql://gradcafe_app:change-me@localhost:5432/gradcafe_test

# Used only by src/setup_db.* to create the gradcafe_app role with this password.
GRADCAFE_APP_PASSWORD=change-me

# Legacy alternative to DATABASE_URL (Module 3): PGHOST, PGPORT, PGDATABASE, PGUSER,
# PGPASSWORD. They are only read when DATABASE_URL is not set.
