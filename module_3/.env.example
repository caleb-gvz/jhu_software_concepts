# Copy these into your shell environment (or your IDE run configuration).
# Real values are NEVER committed: .env files are git-ignored.
#
# PowerShell:   $env:PGUSER = "gradcafe_app"; $env:PGPASSWORD = "<your password>"
# bash / zsh:   export PGUSER=gradcafe_app PGPASSWORD='<your password>'

PGHOST=localhost
PGPORT=5432
PGDATABASE=gradcafe
PGUSER=gradcafe_app
PGPASSWORD=change-me
