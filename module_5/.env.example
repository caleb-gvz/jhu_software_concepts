# Copy this file to module_5/.env (git-ignored) or export these in your shell / CI.
# Real environment variables always win over values in .env.
# Real values are NEVER committed; this file holds placeholders only.

# --- The application (Flask app, command-line tools) -----------------------------------
# Connects as the least-privilege role created by src/db_setup.sql.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gradcafe_m5
DB_USER=gradcafe_m5_app
DB_PASSWORD=change-me

# --- Owner role: used ONLY to provision the schema and by the test suite ---------------
# src/setup_db.sh / setup_db.bat read both passwords to create the two roles.
DB_OWNER_USER=gradcafe_m5_owner
DB_OWNER_PASSWORD=change-me-too

# --- Tests ----------------------------------------------------------------------------
# Scratch database the tests may empty and refill. Owner-level, because the tests create
# and truncate the table.
TEST_DATABASE_URL=postgresql://gradcafe_m5_owner:change-me-too@localhost:5432/gradcafe_m5_test
# The same scratch database as the least-privilege role (tests/test_least_privilege.py).
TEST_APP_DATABASE_URL=postgresql://gradcafe_m5_app:change-me@localhost:5432/gradcafe_m5_test

# --- Optional -------------------------------------------------------------------------
# A full URL that replaces the five DB_* values above (CI uses this).
# DATABASE_URL=postgresql://gradcafe_m5_app:change-me@localhost:5432/gradcafe_m5
